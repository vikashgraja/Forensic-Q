# ==============================================================================
# ForensiQ - Environment Configuration Template
# Copy this file to .env and configure the appropriate values for your environment:
#   cp .env.example .env
# ==============================================================================

# Django Secret Cryptographic Signing Key (Required)
# Generate a unique key for production (e.g. python -c "import secrets; print(secrets.token_urlsafe(50))")
SECRET_KEY=your-super-secret-django-key-min-50-characters-here

# Debug Mode (True for local development, False in production)
DEBUG=True

# Allowed Hosts (Comma-separated hostnames/IPs)
ALLOWED_HOSTS=127.0.0.1,localhost,0.0.0.0

# Master Portal Security Key (Required)
# Password required to unlock the investigative workstation portal
PORTAL_ACCESS_PASSWORD=your-secure-portal-access-password-here

# Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=DEBUG
